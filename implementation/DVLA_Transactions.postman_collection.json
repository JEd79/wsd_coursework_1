{
  "info": {
    "name": "DVLA Transactions Web Service (2356784)",
    "description": "CSF2753 Coursework - all 10 endpoints for the plain-Java DVLA transactions service.\n\nBefore using: start the server with `java WebServer` inside the Implementation folder, then the service listens on http://localhost:8181.\n\nThe {{baseUrl}} variable is set to http://localhost:8181/2356784. Change it in the collection Variables tab if your port or student number differs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8181/2356784",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. List / filter transactions (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions?channel=web&type=vehicle_tax&status=pending&from=2026-01-01&to=2026-03-31",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions" ],
          "query": [
            { "key": "channel", "value": "web" },
            { "key": "type", "value": "vehicle_tax" },
            { "key": "status", "value": "pending" },
            { "key": "from", "value": "2026-01-01" },
            { "key": "to", "value": "2026-03-31" }
          ]
        },
        "description": "List all transactions, with optional filters. All query params are optional - disable (untick) any you do not want. Remove them all to list everything."
      }
    },
    {
      "name": "2. Get one transaction (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions/TXN-100013",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions", "TXN-100013" ]
        },
        "description": "Retrieve a single transaction by its id. Try TXN-100013. A missing id returns 404."
      }
    },
    {
      "name": "3. Create a transaction (POST)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"CUST-4414\",\n  \"channel\": \"web\",\n  \"transactionType\": \"vehicle_tax\",\n  \"vehicleType\": \"car\",\n  \"vehicleReg\": \"AB12 CDE\",\n  \"transactionDate\": \"2026-06-01T09:15:00Z\",\n  \"amount\": 180.00,\n  \"currency\": \"GBP\",\n  \"status\": \"pending\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions" ]
        },
        "description": "Create a new transaction. Do NOT send transactionId - the server assigns it. Returns 201 Created with the new resource."
      }
    },
    {
      "name": "4. Replace a transaction (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"CUST-4414\",\n  \"channel\": \"web\",\n  \"transactionType\": \"vehicle_tax\",\n  \"vehicleType\": \"motorcycle\",\n  \"vehicleReg\": \"UD73 BQO\",\n  \"transactionDate\": \"2026-02-28T15:26:00Z\",\n  \"amount\": 190.00,\n  \"currency\": \"GBP\",\n  \"status\": \"completed\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/transactions/TXN-100013",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions", "TXN-100013" ]
        },
        "description": "Fully replace an existing transaction's details. Returns 200 with the updated resource, or 404 if the id does not exist."
      }
    },
    {
      "name": "5. Update status only (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"refunded\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/transactions/TXN-100013/status",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions", "TXN-100013", "status" ]
        },
        "description": "Change only the status of a transaction. Body is just {\"status\":\"...\"}. Valid values: completed, pending, refunded, failed."
      }
    },
    {
      "name": "6. Delete a transaction (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions/TXN-100000",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions", "TXN-100000" ]
        },
        "description": "Void / delete a transaction. Returns 204 No Content on success, or 404 if it does not exist (deleting twice gives 404 - the operation is idempotent)."
      }
    },
    {
      "name": "7. Customer cost over a date range (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/customers/CUST-4414/transactions/cost?from=2026-01-01&to=2026-12-31",
          "host": [ "{{baseUrl}}" ],
          "path": [ "customers", "CUST-4414", "transactions", "cost" ],
          "query": [
            { "key": "from", "value": "2026-01-01" },
            { "key": "to", "value": "2026-12-31" }
          ]
        },
        "description": "Sum of amount for one customer between two dates. Returns a count and total. On a freshly started server CUST-4414 totals 600.95 over 5 transactions."
      }
    },
    {
      "name": "8. Top-N customers by spend (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/stats/top-customers?metric=spend&limit=5&from=2026-01-01&to=2026-12-31",
          "host": [ "{{baseUrl}}" ],
          "path": [ "stats", "top-customers" ],
          "query": [
            { "key": "metric", "value": "spend" },
            { "key": "limit", "value": "5" },
            { "key": "from", "value": "2026-01-01" },
            { "key": "to", "value": "2026-12-31" }
          ]
        },
        "description": "Top customers ranked by total spend. Change limit to get top 3, top 10, etc."
      }
    },
    {
      "name": "9. Channel usage breakdown (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/stats/channels?from=2026-01-01&to=2026-12-31",
          "host": [ "{{baseUrl}}" ],
          "path": [ "stats", "channels" ],
          "query": [
            { "key": "from", "value": "2026-01-01" },
            { "key": "to", "value": "2026-12-31" }
          ]
        },
        "description": "Transaction count and total amount grouped by channel (web / phone / agent / post_office)."
      }
    },
    {
      "name": "10. A customer's transactions (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/customers/CUST-4414/transactions",
          "host": [ "{{baseUrl}}" ],
          "path": [ "customers", "CUST-4414", "transactions" ]
        },
        "description": "List every transaction belonging to one customer (nested resource)."
      }
    },
    {
      "name": "Extra: Not Found example (GET 404)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions/TXN-999999",
          "host": [ "{{baseUrl}}" ],
          "path": [ "transactions", "TXN-999999" ]
        },
        "description": "Demonstrates the 404 error response and its JSON error body."
      }
    }
  ]
}
